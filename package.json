{
  "name": "@sidekickicons/react-native",
  "version": "0.15.0",
  "description": "Heroicons and Sidekickicons as React Native components.",
  "license": "MIT",
  "keywords": [
    "react-native",
    "icons",
    "heroicons",
    "sidekickicons",
    "svg"
  ],
  "homepage": "https://github.com/ndri/sidekickicons-react-native#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndri/sidekickicons-react-native.git"
  },
  "scripts": {
    "build": "node scripts/download-icons.mjs && node scripts/build-icons.mjs",
    "download-icons": "node scripts/download-icons.mjs",
    "build-icons": "node scripts/build-icons.mjs",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "16",
    "20",
    "24",
    "index.js",
    "index.esm.js",
    "index.d.ts",
    "types.d.ts",
    "LICENSE",
    "HEROICONS-LICENSE",
    "SIDEKICKICONS-LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.esm.js",
      "require": "./index.js"
    },
    "./package.json": {
      "default": "./package.json"
    },
    "./16/solid": {
      "types": "./16/solid/index.d.ts",
      "import": "./16/solid/esm/index.js",
      "require": "./16/solid/index.js"
    },
    "./16/solid/*": {
      "types": "./16/solid/*.d.ts",
      "import": "./16/solid/esm/*.js",
      "require": "./16/solid/*.js"
    },
    "./16/solid/*.js": {
      "types": "./16/solid/*.d.ts",
      "import": "./16/solid/esm/*.js",
      "require": "./16/solid/*.js"
    },
    "./20/solid": {
      "types": "./20/solid/index.d.ts",
      "import": "./20/solid/esm/index.js",
      "require": "./20/solid/index.js"
    },
    "./20/solid/*": {
      "types": "./20/solid/*.d.ts",
      "import": "./20/solid/esm/*.js",
      "require": "./20/solid/*.js"
    },
    "./20/solid/*.js": {
      "types": "./20/solid/*.d.ts",
      "import": "./20/solid/esm/*.js",
      "require": "./20/solid/*.js"
    },
    "./24/outline": {
      "types": "./24/outline/index.d.ts",
      "import": "./24/outline/esm/index.js",
      "require": "./24/outline/index.js"
    },
    "./24/outline/*": {
      "types": "./24/outline/*.d.ts",
      "import": "./24/outline/esm/*.js",
      "require": "./24/outline/*.js"
    },
    "./24/outline/*.js": {
      "types": "./24/outline/*.d.ts",
      "import": "./24/outline/esm/*.js",
      "require": "./24/outline/*.js"
    },
    "./24/solid": {
      "types": "./24/solid/index.d.ts",
      "import": "./24/solid/esm/index.js",
      "require": "./24/solid/index.js"
    },
    "./24/solid/*": {
      "types": "./24/solid/*.d.ts",
      "import": "./24/solid/esm/*.js",
      "require": "./24/solid/*.js"
    },
    "./24/solid/*.js": {
      "types": "./24/solid/*.d.ts",
      "import": "./24/solid/esm/*.js",
      "require": "./24/solid/*.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": "*",
    "react-native-svg": ">=13"
  }
}
